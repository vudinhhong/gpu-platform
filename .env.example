# Template configuration.  Copy to .env and adjust.
#   cp .env.example .env

# ── Core ─────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string   # openssl rand -hex 32
ADMIN_PASSWORD=admin123                      # change after first login
GPU_COUNT=2

# ── HTTP entry point ─────────────────────────────────────────────────
# host = this machine already runs nginx/Caddy/Apache on :80/:443.  The
#        stack publishes only WEB_BIND:WEB_PORT and the host server proxies
#        to it (see nginx/host/gpu-platform.conf).
# edge = the bundled nginx container owns :80/:443 (compose profile "edge").
# deploy.sh auto-detects when this is unset.
HTTP_MODE=host
WEB_BIND=127.0.0.1
WEB_PORT=7080
# Bind address for the backend API port (debugging); 127.0.0.1 keeps it off
# the network; the web tier reaches it over the Docker network regardless.
BACKEND_BIND=127.0.0.1

# ── Session backend ──────────────────────────────────────────────────
# process   = jupyter lab subprocess (legacy, single container)
# container = one Docker container per user (required for real GPU isolation;
#             needs /var/run/docker.sock mounted into backend)
SESSION_BACKEND=container
JUPYTER_IMAGE=gpu-jupyter:latest
# Optional allow-list users may choose from: "Label=image,Label2=image2".
# Anything outside this list is rejected; the client never names a raw image.
JUPYTER_IMAGES=
DOCKER_NETWORK=workspace-gpu_gpu-net
JUPYTER_DATA_DIR=/jupyter_data
# Path of jupyter_data as seen on the DOCKER HOST.  Bind mounts for user
# containers are resolved against the host filesystem (deploy.sh fills this in;
# a stale value from another machine breaks every session).
JUPYTER_DATA_HOST_DIR=
# Directory an administrator may map a user's workspace into, when that user
# already has a home on this machine (Admin → Users → Home directory).  A
# mapping must live under this root, so a typo cannot mount "/" into a shell.
# Requires docker-compose.homes.yml so the backend can see the same paths.
HOME_MOUNT_ROOT=/home
JUPYTER_PORT_START=8100
JUPYTER_PORT_END=8199

# ── Security ─────────────────────────────────────────────────────────
# Session lifetime.  Revocation does not depend on it: deactivating a user,
# resetting their password or changing their admin flag kills existing tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=480
MIN_PASSWORD_LENGTH=10
# Force the Secure flag on the Jupyter proxy cookie.  Leave false only for
# plain-HTTP LAN installs; set true whenever TLS terminates upstream.
COOKIE_SECURE=false
# Login throttling (per username AND per IP)
LOGIN_MAX_FAILURES=8
LOGIN_FAIL_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
# Show simulated GPUs when nvidia-smi is missing.  Keep false in production:
# phantom hardware lets admins assign GPUs that do not exist.
ALLOW_MOCK_GPU=false

# ── One password per user ────────────────────────────────────────────
# true  = Jupyter and SSH both accept the PLATFORM ACCOUNT password.  Nothing
#         for the user to configure, no SSH password to reveal, no token in
#         the Jupyter URL.  The account password is never stored in clear: an
#         argon2 hash (for Jupyter) and a sha512-crypt hash (for /etc/shadow)
#         are derived when the password is set, changed, reset or first used
#         to log in.
# false = previous behaviour: a random per-session SSH password and token
#         links for Jupyter.
UNIFIED_PASSWORD=true
# Accept password authentication over SSH at all.  NOTE: the SSH port range is
# reachable from the internet and sshd is NOT covered by the platform's login
# lockout, so with UNIFIED_PASSWORD=true the account password gains an
# unthrottled attack surface.  Set false for key-only access.
SSH_PASSWORD_AUTH=true

# ── Per-user resource limits (0 = unlimited) ─────────────────────────
# container backend: cgroups.  process backend: OS rlimits.
DEFAULT_MEMORY_LIMIT_MB=8192
# RLIMIT_CPU: cumulative CPU-seconds one process tree may burn before the
# kernel kills it.  PROCESS BACKEND ONLY; cgroups have no equivalent, so the
# container backend ignores it.  For a compute budget that works on both, use
# DEFAULT_CPU_HOURS_QUOTA below.
DEFAULT_CPU_LIMIT_SECONDS=0
DEFAULT_CPU_CORES=2
# cgroup pids.max per container: the fork-bomb ceiling
CONTAINER_PIDS_LIMIT=512
# Size of /dev/shm in a workspace.  Docker's default is 64 MB, which is too
# small for anything passing data between processes through shared memory, a
# PyTorch DataLoader with workers exhausts it at once and its workers die with
# "Connection reset by peer", which looks like a bug in the user's code.
# Capped at half the memory limit, since tmpfs comes out of the same budget.
CONTAINER_SHM_SIZE_MB=2048

# ── Quotas (0 = unlimited; per-user overrides live in Admin → Users) ──
# Disk budget for jupyter_data/<user>; a session refuses to start above it.
DEFAULT_DISK_QUOTA_MB=0
# What to do when a RUNNING session goes over its disk quota.  The data
# directory is a plain bind mount with no filesystem quota, so this loop is the
# only enforcement; `df` inside a container shows the whole host disk.
#   warn = record it and show it to admins    stop = also stop the session
DISK_QUOTA_ACTION=warn
# How long a time budget lasts before it refills: week (Monday) or month (1st).
QUOTA_PERIOD=week
# Hours east of UTC, so "refills on Monday" means the user's Monday.  Hanoi = 7.
QUOTA_TZ_OFFSET_HOURS=0
# The two time budgets below cover the BATCH QUEUE and nothing else.  A
# workspace is the user's own seat at the machine and is already bounded by
# their assignment; the queue is work left to run unattended, where one person
# submitting fifty jobs takes the machine from everybody else.  An interactive
# session therefore costs nothing here (use IDLE_TIMEOUT_MINUTES for one left
# open and unused).
#
# GPU-hours a user's jobs may spend per period, as hours x cards held.
DEFAULT_GPU_HOURS_QUOTA=0
# CPU core-hours their jobs may spend, as hours x cores allocated: a 4-core job
# running for an hour costs 4.
DEFAULT_CPU_HOURS_QUOTA=0
# What to do about a RUNNING JOB whose owner has just run out.
#   requeue = stop it and put it back in the queue, where it starts again by
#             itself once the budget refills.  The script re-runs from the
#             beginning and rewrites its output, so long jobs should checkpoint
#   stop    = stop it and mark it failed       warn = note it and let it run
JOB_TIME_QUOTA_ACTION=requeue
# A job holding no GPU is treated differently, because it can be frozen
# instead: every process stops where it stands and the scheduler thaws it when
# the budget refills, so nothing is re-run and nothing is lost.  A frozen
# container still holds its RAM, which is why this is not offered for GPU
# jobs, where what it would hold is a whole card.
#   pause = freeze it and resume it at the refill (default)
#   anything else = fall back to JOB_TIME_QUOTA_ACTION above
JOB_TIME_QUOTA_CPU_ACTION=pause
# How often a running workspace's copy of these figures is refreshed for its
# `limits` command.  The budgets are applied by the scheduler, every
# JOB_SCHEDULER_INTERVAL seconds.
QUOTA_REFRESH_INTERVAL_SECONDS=60

# ── Batch job queue ──────────────────────────────────────────────────
# Users submit a shell script with `submit` from inside their workspace; the
# scheduler runs it when a GPU has room.  Submitting does NOT require owning a
# GPU, and that is the point: idle cards get used and everyone shares them by
# time instead of by static assignment.  A running job is capped exactly like
# its owner's workspace.
JOBS_ENABLED=true
# How often the scheduler finalises finished jobs and starts queued ones.
JOB_SCHEDULER_INTERVAL=10
# How often VRAM is sampled and the reservation enforced.  Kept separate from
# the scheduler above, and far shorter, because it is the window a job can
# overrun its reservation in before anything notices -- and nothing on a
# consumer board stops the allocation itself.  One nvidia-smi covers every job,
# so this does not get more expensive as the queue grows.
GPU_GUARD_INTERVAL=1
# Jobs one user may run at once, so one person's backlog cannot take every GPU.
JOB_MAX_RUNNING_PER_USER=2
JOB_MAX_QUEUED_PER_USER=50
# VRAM left unclaimed on a card after admitting a job.
JOB_GPU_HEADROOM_MB=512
# There is no default GPU memory figure on purpose: a job that names none is
# a CPU job, and a job that wants a GPU must say how much of one it needs.
# Stop a job still running after this many minutes (0 = no limit).
JOB_MAX_RUNTIME_MINUTES=0
# GPU indices the queue may use; empty = all of them.
JOB_GPU_POOL=
# How much of a job's output the dashboard and `queue <id>` show.  Only the end
# of the file is ever read, so a multi-gigabyte log costs nothing to display.
JOB_OUTPUT_TAIL_LINES=500
JOB_OUTPUT_TAIL_BYTES=131072
JOB_OUTPUT_MAX_LINE_CHARS=1000
# A \r progress bar is one line in the file but keeps appending to it.  tqdm at
# a few thousand iterations a second writes hundreds of MB an hour.  Past this
# the job is flagged so its owner can see what is eating their quota.
# --gpu-memory is a scheduling reservation and these GPUs cannot partition
# memory in hardware, so the platform enforces it: a job found holding more
# than its allowance is stopped and told what it really used, because an
# unenforced reservation pays to understate: it jumps the queue, and the job
# placed into the space that was never free is the one that dies.
# Allowance = max(request x FACTOR, request + GRACE_MB); the grace covers the
# CUDA context, several hundred MB the job never asked for.
# Set ACTION=warn to make reservations advisory again.
JOB_GPU_OVERRUN_FACTOR=1.1
JOB_GPU_OVERRUN_GRACE_MB=1024
JOB_GPU_OVERRUN_ACTION=stop
JOB_OUTPUT_WARN_MB=512
# A hard ceiling that stops the job.  0 = never; killing a long training run
# over a verbose log is usually worse than the log.
JOB_MAX_OUTPUT_MB=0
# CPU cores the queue may hand out (0 = every core minus the reserve below).
# Jobs that ask for no GPU are admitted against this.
JOB_CPU_POOL_CORES=0
# Cores kept back for the platform and for interactive work.
JOB_CPU_RESERVED_CORES=4

# ── Fair share ───────────────────────────────────────────────────────
# Queue order is by how much each user has been given, not by who submitted
# first.  Ten jobs from one person must not push everyone else behind them.
# Score = recent usage (decayed) + what they are running now; lowest goes first.
FAIRSHARE_WINDOW_HOURS=24
# After one half-life, past usage weighs half as much.
FAIRSHARE_HALFLIFE_HOURS=6
# One CPU-core-second in GPU-seconds, so the two can be added up.
FAIRSHARE_CPU_CORE_WEIGHT=0.125
# A running job counts as if it will run this much longer, which is what makes
# the queue interleave between users instead of draining one backlog.
FAIRSHARE_LOOKAHEAD_SECONDS=600

# ── Lifecycle ────────────────────────────────────────────────────────
# Stop sessions with no traffic for this long (0 = never).  The highest-value
# knob on a small cluster: it returns GPUs people forgot to release.
IDLE_TIMEOUT_MINUTES=0
REAPER_INTERVAL_SECONDS=300
# Resource telemetry refresh (docker stats + /proc), seconds
METRICS_INTERVAL_SECONDS=10
# Keep user sessions running across a backend restart/update.
KEEP_SESSIONS_ON_SHUTDOWN=true
# GPU keep-alive touch interval inside user containers (anti-detach), seconds
GPU_KEEPER_INTERVAL=120
# Self-heal scan interval for dead containers, seconds
SELF_HEAL_INTERVAL=30

# ── Disk I/O limits per user container (container backend) ───────────
# Hard ceilings (MB/s) stop one user's bulk copy from starving everyone.
# 0 = unlimited for that direction.  A knob the Docker daemon will not take is
# skipped with a warning rather than failing the session.
DISK_READ_BPS_MB=150
DISK_WRITE_BPS_MB=80
DISK_READ_IOPS=0
DISK_WRITE_IOPS=0
# Relative share when containers contend for the same disk (10..1000).
#
# IGNORED ON cgroup v2, which is every current distro.  This is a cgroup v1
# control; on v2 it converts to io.weight, and io.weight only does anything
# when the device runs the BFQ scheduler or has blk-iocost configured.  On a
# stock NVMe host neither is true, so the platform does not send it and the
# ceilings above are the only disk limits in force.  See the README.
BLKIO_WEIGHT=500

# ── SSH access (container backend) ──────────────────────────────────
SSH_ENABLED=true
SSH_PORT_START=2222
SSH_PORT_END=2321
